# Sanity — backoffice / CMS
# Récupère le Project ID après avoir créé un projet sur https://sanity.io
# (ou via `npx sanity init`). Mets la même valeur dans les deux jeux de clés :
# NEXT_PUBLIC_* pour le site Next.js, SANITY_STUDIO_* pour le studio (CLI).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
